# PostgreSQL connection string
DATABASE_URL="postgresql://devtrace:devtrace_local@localhost:5432/devtrace"

# Public URL of this app (used for OAuth callbacks and cookies)
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# GitHub OAuth app (https://github.com/settings/developers)
# Callback URL: <NEXTAUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Optional. Default "read:user user:email repo". Use "read:user user:email" for public data only.
# GITHUB_OAUTH_SCOPE=""

# Encrypts stored GitHub tokens (AES-256-GCM). Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""

# Optional: Redis for caching and cross-process rate limits
REDIS_URL="redis://localhost:6379"

# Optional: demo mode (default enabled)
# DEMO_ENABLED="true"

# Optional: AI weekly summary. Disabled when unset.
# ANTHROPIC_API_KEY=""
# AI_SUMMARY_MODEL="claude-opus-5-5"
