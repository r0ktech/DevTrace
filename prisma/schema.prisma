generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Source code hosts. Only GitHub is implemented; the column exists so
// GitLab/Bitbucket data can live in the same tables later.
enum Provider {
  github
}

// ─── Auth (NextAuth adapter models) ─────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  isDemo        Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  connectedAccounts ConnectedAccount[]
  repositories      Repository[]
  commits           Commit[]
  pullRequests      PullRequest[]
  issues            Issue[]
  contributionDays  ContributionDay[]
  syncJobs          SyncJob[]
  weeklySummaries   WeeklySummary[]
  preferences       UserPreference?

  @@map("users")
}

// OAuth credentials. access_token is AES-256-GCM encrypted at rest
// (see src/server/auth/crypto.js) and never leaves the server.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Connected source account (GitHub profile) ──────────────────────

model ConnectedAccount {
  id               String    @id @default(cuid())
  userId           String
  provider         Provider  @default(github)
  externalId       String
  login            String
  name             String?
  avatarUrl        String?
  bio              String?   @db.Text
  company          String?
  location         String?
  blog             String?
  profileUrl       String?
  publicRepos      Int       @default(0)
  followers        Int       @default(0)
  following        Int       @default(0)
  accountCreatedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@unique([userId, provider])
  @@index([provider, login])
  @@map("connected_accounts")
}

// ─── Repository ─────────────────────────────────────────────────────

model Repository {
  id              String    @id @default(cuid())
  userId          String
  provider        Provider  @default(github)
  externalId      String
  ownerLogin      String
  name            String
  fullName        String
  description     String?   @db.Text
  url             String?
  homepage        String?
  primaryLanguage String?
  stars           Int       @default(0)
  forks           Int       @default(0)
  openIssues      Int       @default(0)
  sizeKb          Int       @default(0)
  isPrivate       Boolean   @default(false)
  isFork          Boolean   @default(false)
  isArchived      Boolean   @default(false)
  // true when the user owns the repo; false for org/collaborator/contribution repos
  isOwner         Boolean   @default(false)
  // false when the repo was only discovered through the user's PRs/issues
  isAffiliated    Boolean   @default(true)
  defaultBranch   String?
  repoCreatedAt   DateTime?
  repoPushedAt    DateTime?
  // Set when GitHub stops returning the repo (deleted or access revoked).
  // Historical activity is kept; the repo is hidden from repository lists.
  removedAt       DateTime?
  // Incremental sync cursor for commits on the default branch
  commitsSyncedAt DateTime?
  contributorsSyncedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  commits       Commit[]
  pullRequests  PullRequest[]
  issues        Issue[]
  languageStats LanguageStat[]
  contributors  RepositoryContributor[]

  @@unique([userId, provider, externalId])
  @@index([userId, removedAt])
  @@index([userId, primaryLanguage])
  @@index([userId, repoPushedAt])
  @@map("repositories")
}

// ─── Commit ─────────────────────────────────────────────────────────

model Commit {
  id           String   @id @default(cuid())
  userId       String
  repositoryId String
  sha          String
  message      String   @db.Text
  authorName   String?
  authorEmail  String?
  authorLogin  String?
  committedAt  DateTime
  url          String?
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, sha])
  @@index([userId, committedAt])
  @@index([repositoryId, committedAt])
  @@map("commits")
}

// ─── Pull request ───────────────────────────────────────────────────

model PullRequest {
  id           String    @id @default(cuid())
  userId       String
  repositoryId String
  externalId   String
  number       Int
  title        String
  // open | closed | merged
  state        String
  isDraft      Boolean   @default(false)
  authorLogin  String?
  url          String?
  additions    Int?
  deletions    Int?
  changedFiles Int?
  headRef      String?
  baseRef      String?
  openedAt     DateTime
  mergedAt     DateTime?
  closedAt     DateTime?
  remoteUpdatedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, number])
  @@index([userId, openedAt])
  @@index([userId, state])
  @@index([userId, mergedAt])
  @@index([repositoryId, openedAt])
  @@map("pull_requests")
}

// ─── Issue ──────────────────────────────────────────────────────────

model Issue {
  id           String    @id @default(cuid())
  userId       String
  repositoryId String
  externalId   String
  number       Int
  title        String
  // open | closed
  state        String
  authorLogin  String?
  labels       String[]
  comments     Int       @default(0)
  url          String?
  openedAt     DateTime
  closedAt     DateTime?
  remoteUpdatedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, number])
  @@index([userId, openedAt])
  @@index([userId, state])
  @@index([userId, closedAt])
  @@index([repositoryId, openedAt])
  @@map("issues")
}

// ─── Language bytes per repository (from GitHub linguist) ───────────

model LanguageStat {
  id           String  @id @default(cuid())
  repositoryId String
  language     String
  bytes        Int
  color        String?

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, language])
  @@index([language])
  @@map("language_stats")
}

// ─── Repository contributors (fetched on demand, refreshed daily) ───

model RepositoryContributor {
  id            String  @id @default(cuid())
  repositoryId  String
  login         String
  avatarUrl     String?
  url           String?
  contributions Int

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, login])
  @@map("repository_contributors")
}

// ─── Contribution calendar (GitHub's own daily contribution counts) ─

model ContributionDay {
  id     String   @id @default(cuid())
  userId String
  date   DateTime @db.Date
  count  Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("contribution_days")
}

// ─── Sync job ───────────────────────────────────────────────────────

model SyncJob {
  id           String    @id @default(cuid())
  userId       String
  // queued | running | completed | failed
  status       String    @default("queued")
  // initial | manual | retry
  trigger      String    @default("manual")
  // { [stage]: { status: pending|running|done|failed, count?: number } }
  stages       Json
  currentStage String?
  errorCode    String?
  errorMessage String?   @db.Text
  retryAfter   DateTime?
  startedAt    DateTime?
  finishedAt   DateTime?
  heartbeatAt  DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
  @@map("sync_jobs")
}

// ─── Preferences & privacy ──────────────────────────────────────────

model UserPreference {
  id               String   @id @default(cuid())
  userId           String   @unique
  theme            String   @default("system")
  defaultRange     String   @default("30d")
  // all | owned | exclude-forks
  defaultRepoScope String   @default("all")
  timezone         String?
  publicProfile    Boolean  @default(false)
  // Show the contribution heatmap and activity stats on the public profile
  profileShowActivity Boolean @default(true)
  // Never list private repositories on the public profile unless enabled
  profileShowPrivateRepos Boolean @default(false)
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// ─── Optional AI weekly summary ─────────────────────────────────────

model WeeklySummary {
  id          String   @id @default(cuid())
  userId      String
  periodStart DateTime
  periodEnd   DateTime
  content     String   @db.Text
  metrics     Json
  model       String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("weekly_summaries")
}
